# The server's address: a domain (pointed at this server with an A record) or a bare IP.
DOMAIN=chat.example.ir
# HTTPS: auto (Let's Encrypt; needs international internet) | internal (the server's own SSL,
# fully offline) | custom (./certs/cert.pem + key.pem) | off (plain HTTP: chat only, no calls)
# TLS_MODE=auto
# Also answer on the server's IP (https with the server's own SSL, and plain http): 1 = yes
# ALSO_IP=1
# Serve the app over plain http:// too instead of redirecting to https: 1 = yes
# ALLOW_HTTP=0
# After changing any of the above: sudo amorechat-update  (or: sudo bash deploy/caddy-config.sh && sudo docker compose restart caddy)
# Number of daily database backups to keep in data/backups.
BACKUP_KEEP=14
LOG_LEVEL=info
# Server's public IP (used for calls/voice). Detected automatically on install.
PUBLIC_IP=
# Secret shared with the LiveKit media server. Generated automatically on install.
LIVEKIT_API_SECRET=

# Tele (Telegram bridge) — get api_id / api_hash from https://my.telegram.org
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
# Optional path to sing-box binary (default: looks on PATH and data/bin/sing-box)
# SING_BOX_PATH=
# Local SOCKS port used only for Telegram egress (default 17890)
# TELE_SOCKS_PORT=17890
# Minutes without anyone using Tele before the Telegram connection closes to save the server's
# VPN traffic (it opens again when a chat is opened). Default 10.
# TELE_IDLE_MINUTES=10
