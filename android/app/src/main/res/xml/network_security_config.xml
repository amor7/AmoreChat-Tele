<?xml version="1.0" encoding="utf-8"?>
<!-- Plain HTTP is only used to fetch a server's own certificate (/ca.crt) and for
     servers without TLS; the user's own CA is trusted in code, per server. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
