{
  "name": "amorechat",
  "private": true,
  "version": "1.0.16",
  "description": "AmoreChat-Tele: self-hosted messenger + Telegram bridge",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev:server": "npm run dev -w server",
    "dev:web": "npm run dev -w web",
    "build": "npm run build -w web",
    "start": "npm start -w server"
  },
  "overrides": {
    "@fastify/static": {
      "glob": "^14.0.3"
    }
  },
  "engines": {
    "node": ">=24"
  }
}
